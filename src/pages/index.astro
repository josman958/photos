---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import WorkGallery from '../components/WorkGallery.astro';
import Interlude from '../components/Interlude.astro';
import Collections from '../components/Collections.astro';
import Testimonials from '../components/Testimonials.astro';
import Contact from '../components/Contact.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Lightbox from '../components/Lightbox.astro';
---

<BaseLayout>
  <main id="contenido">
    <Hero />
    <About />
    <WorkGallery />
    <Interlude />
    <Collections />
    <Testimonials />
    <Contact />
  </main>

  <SiteFooter />
  <Lightbox />
</BaseLayout>

<script>
  import { initUI } from '../scripts/ui';
  import { initMotion } from '../scripts/motion';
  import { initLightbox } from '../scripts/lightbox';

  initUI();
  initLightbox();
  initMotion();
</script>
