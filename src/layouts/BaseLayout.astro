---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import { site } from '../data/site';

import frauncesUrl from '../assets/fonts/fraunces-latin.woff2?url';
import frauncesItalicUrl from '../assets/fonts/fraunces-italic-latin.woff2?url';
import manropeUrl from '../assets/fonts/manrope-latin.woff2?url';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Josman — Fotografía de paisaje, viaje y retrato',
  description = site.description,
} = Astro.props;

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const siteUrl = Astro.site ?? new URL('https://josman958.github.io');
const canonical = new URL(Astro.url.pathname, siteUrl);
const ogImage = new URL(`${base}og.jpg`, siteUrl);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.fullName,
  jobTitle: 'Fotógrafo de paisaje, viaje y retrato',
  url: canonical.href,
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Huaraz',
    addressRegion: 'Áncash',
    addressCountry: 'PE',
  },
  sameAs: [site.instagramUrl],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f3eee4" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:site_name" content="Josman Fotografía" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Laguna turquesa rodeada de montañas nevadas." />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" type="image/png" sizes="64x64" href={`${base}favicon.png`} />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href={`${base}apple-touch-icon.png`}
    />

    <link
      rel="preload"
      href={frauncesUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={frauncesItalicUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={manropeUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>

  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <SiteHeader />

    <div id="smooth-wrapper">
      <div id="smooth-content">
        <slot />
      </div>
    </div>

    <div class="grain" aria-hidden="true"></div>
    <div class="scroll-progress" data-scroll-progress aria-hidden="true"></div>
  </body>
</html>
