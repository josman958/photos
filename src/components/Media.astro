---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
  ratio?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  parallax?: number;
  hover?: boolean;
  reveal?: boolean;
  class?: string;
  quality?: number;
}

const {
  src,
  alt,
  widths,
  sizes,
  ratio,
  loading = 'lazy',
  fetchpriority = 'auto',
  parallax = 0,
  hover = false,
  reveal = true,
  class: className,
  quality = 78,
} = Astro.props;

const ratioValue = ratio ?? `${src.width} / ${src.height}`;
---

<div
  class:list={['media', hover && 'media--hover', className]}
  style={`--media-ratio: ${ratioValue}`}
  data-reveal-media={reveal ? '' : undefined}
>
  <div class="media__inner" data-parallax={parallax || undefined}>
    <Image
      src={src}
      alt={alt}
      widths={widths}
      sizes={sizes}
      loading={loading}
      fetchpriority={fetchpriority}
      format="webp"
      quality={quality}
    />
  </div>
</div>
